# Copy to .env.local. Every variable is optional: with none set, the gateway
# runs in simulated mode with in-process memory.

# OpenRouter keys for real model calls (free tier: 50 requests/day per key).
# Extra keys from separate accounts are tried in order when one hits 429.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=

# Upstash Redis: persists bandit state, breaker state, A/B tallies and rate
# limits across restarts and serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Vector index with the hosted text-embedding-3-small model (1536 dims,
# cosine): enables the semantic cache. Without it a lexical cache is used.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Optional extra tenants, as key:Name:requestsPerMinute, comma-separated.
# Requests without an x-api-key header use the public tenant (600/min).
MUX_TENANTS=

# Share of real-key requests also sent to the flagship and a random model to
# measure the A/B comparison (default 0.1). Mainly for testing.
MUX_SHADOW_SAMPLE=
